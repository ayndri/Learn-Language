# Salin ke .env.local lalu isi nilainya. File ini AMAN di-commit — jangan taruh nilai asli di sini.

# Neon connection string (pakai yang -pooler untuk serverless)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL_LESSON="gemini-flash-latest"
GEMINI_MODEL_ITEMS="gemini-flash-lite-latest"

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Dipakai sekali oleh `npm run db:seed-user`, lalu HAPUS SEED_PASSWORD-nya.
# Hash-nya tersimpan di database; password mentah tidak perlu ada di file mana pun.
SEED_USERNAME=""
SEED_PASSWORD=""

# Jalan keluar yang harus disengaja: izinkan password di bawah 12 karakter.
# Masuk akal untuk localhost. JANGAN dipakai setelah dideploy — halaman login
# terbuka di internet dan kuota AI menempel di belakang sesi yang login.
#   SEED_ALLOW_WEAK=1 npx tsx --env-file=.env.local lib/db/seed-user.ts
# SEED_ALLOW_WEAK=""

# Opsional — provider cadangan kalau kuota Gemini habis
GROQ_API_KEY=""
